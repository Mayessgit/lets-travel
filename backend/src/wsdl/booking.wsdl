      </xsd:complexType>

      <xsd:complexType name="Payment">
        <xsd:sequence>
          <xsd:element name="id" type="xsd:int"/>
          <xsd:element name="reservationId" type="xsd:int"/>
          <xsd:element name="amount" type="xsd:decimal"/>
          <xsd:element name="method" type="xsd:string"/>
