          <xsd:element name="userName" type="xsd:string" minOccurs="0"/>
          <xsd:element name="serviceName" type="xsd:string" minOccurs="0"/>
        </xsd:sequence>
      </xsd:complexType>

      <xsd:complexType name="Notification">
