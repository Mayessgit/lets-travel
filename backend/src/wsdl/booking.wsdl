<?xml version="1.0" encoding="UTF-8"?>
<!-- Contrat WSDL de la plateforme de réservation (maintenu à la main). Style : document/literal.
     Authentification : en-tête SOAP <tns:AuthToken> contenant le JWT obtenu via loginUser. -->
<wsdl:definitions name="BookingPlatform"
