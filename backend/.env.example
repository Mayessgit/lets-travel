PORT=4000
# URL publique utilisée dans le WSDL (soap:address)
PUBLIC_URL=http://localhost:4000

# MySQL / MariaDB (XAMPP : utilisateur root sans mot de passe par défaut)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=booking_soap_db

# Authentification
JWT_SECRET=remplacez-par-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=2h

# Une réservation non payée est annulée automatiquement après ce délai (minutes)
RESERVATION_TTL_MINUTES=15

# Anti force brute sur loginUser : après LOGIN_MAX_ATTEMPTS échecs
# pour le même email, le compte est bloqué LOGIN_LOCK_MINUTES minutes
# (compteur en mémoire du processus, remis à zéro après une connexion réussie)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Origines autorisées pour le frontend React (séparées par des virgules)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
